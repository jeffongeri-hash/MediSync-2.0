// MediSync data model. Synthetic data only.
// Raw sources are stored untouched; canonical resources are FHIR R4 JSON derived from them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SourceFormat {
  FHIR_BUNDLE
  FHIR_NDJSON
  CCDA
}

enum IssueSeverity {
  INFO
  WARNING
  ERROR
}

enum IssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

/// Which pipeline step raised an issue; a step replaces only its own OPEN issues when it re-runs.
enum IssueStage {
  INGEST
  MAPPING
  DEDUPE
  EXPORT
}

/// Lifecycle of a transfer job. Jobs run synchronously today; the states also fit a queue later.
enum TransferStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Terminology outcome for a canonical resource's primary code.
enum MappingStatus {
  MAPPED // known system, well-formed code, present in the local terminology table
  UNMAPPED // has a code, but the system or code is unknown or malformed; in the review queue
  NO_CODE // the type expects a primary code and has none (or only text)
  NOT_APPLICABLE // the type has no primary code (Patient)
}

enum AuditAction {
  READ
  CREATE
  UPDATE
  DELETE
  EXPORT
  /// A SMART on FHIR launch completed (Phase 5).
  LOGIN
}

/// Patient index. Demographics are a convenience copy; the canonical Patient resource is the source of truth.
model Patient {
  id              String    @id @default(uuid()) @db.Uuid
  sourceSystem    String    @map("source_system")
  sourcePatientId String    @map("source_patient_id")
  displayName     String?   @map("display_name")
  birthDate       DateTime? @map("birth_date") @db.Date
  gender          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sourceRecords      SourceRecord[]
  canonicalResources CanonicalResource[]
  mappingIssues      MappingIssue[]
  transferJobs       TransferJob[]
  reconciliationRuns ReconciliationRun[] @relation("RunPatient")
  incomingRuns       ReconciliationRun[] @relation("RunIncomingPatient")
  smartSessions      SmartSession[]

  @@unique([sourceSystem, sourcePatientId])
  @@map("patients")
}

/// One received document (bundle, NDJSON file, C-CDA). raw_text is the exact original text, never modified.
model SourceRecord {
  id             String       @id @default(uuid()) @db.Uuid
  patientId      String?      @map("patient_id") @db.Uuid
  format         SourceFormat
  sourceSystem   String       @map("source_system")
  sourceRecordId String?      @map("source_record_id")
  filename       String?
  contentType    String       @map("content_type")
  rawText        String       @map("raw_text")
  sha256         String       @unique
  byteSize       Int          @map("byte_size")
  /// Derived at ingest (e.g. resource counts). Never a substitute for raw_text.
  summary        Json?
  receivedAt     DateTime     @default(now()) @map("received_at")
  /// Set once canonical rows and issues exist for this source. Raw is immutable; derived rows are not re-made.
  parsedAt       DateTime?    @map("parsed_at")
  parserVersion  String?      @map("parser_version")

  patient            Patient?            @relation(fields: [patientId], references: [id])
  canonicalResources CanonicalResource[]
  mappingIssues      MappingIssue[]
  reconciliationRuns ReconciliationRun[]
  smartSessions      SmartSession[]

  @@index([patientId])
  @@map("source_records")
}

/// FHIR R4 resource in the canonical model, with provenance back to its source record.
model CanonicalResource {
  id             String   @id @default(uuid()) @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  sourceRecordId String   @map("source_record_id") @db.Uuid
  resourceType   String   @map("resource_type")
  fhirId         String   @map("fhir_id")
  fhirVersion    String   @default("4.0.1") @map("fhir_version")
  resource       Json
  /// Location in the raw source, e.g. "Bundle.entry[12]" or an XPath.
  sourcePath     String?  @map("source_path")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Phase 2. `resource` stays the canonical copy as received; `mapped` is that copy after terminology and unit
  // normalization plus meta.source, recomputed from `resource` whenever the mapping version changes.
  mapped         Json?
  mappingVersion String?        @map("mapping_version")
  mappingStatus  MappingStatus? @map("mapping_status")
  /// Primary clinical code after mapping (medicationReference resolved), for dedupe, coverage and reconcile.
  codeSystem     String?        @map("code_system")
  code           String?
  /// Provenance: the system that asserted the resource and the clinical date it asserts.
  sourceSystem   String?        @map("source_system")
  sourceDate     DateTime?      @map("source_date") @db.Timestamptz(3)
  /// Cross-format duplicates of one clinical fact share a key; all but one point at the primary row.
  dedupeKey      String?        @map("dedupe_key")
  duplicateOfId  String?        @map("duplicate_of_id") @db.Uuid

  patient       Patient              @relation(fields: [patientId], references: [id])
  sourceRecord  SourceRecord         @relation(fields: [sourceRecordId], references: [id])
  mappingIssues MappingIssue[]
  duplicateOf   CanonicalResource?   @relation("Duplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    CanonicalResource[]  @relation("Duplicates")
  currentItems  ReconciliationItem[] @relation("ItemCurrent")
  incomingItems ReconciliationItem[] @relation("ItemIncoming")

  @@unique([sourceRecordId, resourceType, fhirId])
  @@index([patientId, resourceType])
  @@index([patientId, dedupeKey])
  @@index([mappingStatus])
  @@map("canonical_resources")
}

/// Review queue: validation failures, unmapped codes, lossy conversions. Nothing is silently dropped.
model MappingIssue {
  id                  String        @id @default(uuid()) @db.Uuid
  patientId           String?       @map("patient_id") @db.Uuid
  sourceRecordId      String        @map("source_record_id") @db.Uuid
  canonicalResourceId String?       @map("canonical_resource_id") @db.Uuid
  stage               IssueStage    @default(INGEST)
  severity            IssueSeverity
  code                String
  message             String
  path                String?
  details             Json?
  status              IssueStatus   @default(OPEN)
  resolvedBy          String?       @map("resolved_by")
  resolvedAt          DateTime?     @map("resolved_at")
  createdAt           DateTime      @default(now()) @map("created_at")

  patient           Patient?           @relation(fields: [patientId], references: [id])
  sourceRecord      SourceRecord       @relation(fields: [sourceRecordId], references: [id])
  canonicalResource CanonicalResource? @relation(fields: [canonicalResourceId], references: [id])

  @@index([status, code])
  @@index([stage, canonicalResourceId])
  @@index([patientId])
  @@map("mapping_issues")
}

/// Append-only (enforced by trigger). No FKs so entries outlive the rows they describe. details must not hold PHI.
model AuditLog {
  id         BigInt      @id @default(autoincrement())
  occurredAt DateTime    @default(now()) @map("occurred_at")
  actor      String
  action     AuditAction
  patientId  String?     @map("patient_id") @db.Uuid
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  source     String?
  details    Json?

  @@index([patientId, occurredAt])
  @@index([occurredAt])
  @@map("audit_log")
}

/// One transfer of a patient's canonical record to a target profile (Phase 3: US Core FHIR transaction Bundle).
/// A dry run computes everything (diff, score, report, bundle hash) but does not keep the bundle.
model TransferJob {
  id                String         @id @default(uuid()) @db.Uuid
  patientId         String         @map("patient_id") @db.Uuid
  dryRun            Boolean        @map("dry_run")
  status            TransferStatus @default(PENDING)
  /// e.g. "us-core@6.1.0"
  targetProfile     String         @map("target_profile")
  requestedBy       String         @map("requested_by")
  createdAt         DateTime       @default(now()) @map("created_at")
  startedAt         DateTime?      @map("started_at")
  finishedAt        DateTime?      @map("finished_at")
  /// The export timestamp written into the bundle and Provenance; same inputs + same exportedAt = same bytes.
  exportedAt        DateTime?      @map("exported_at") @db.Timestamptz(3)
  resourcesSelected Int?           @map("resources_selected")
  resourcesExported Int?           @map("resources_exported")
  resourcesExcluded Int?           @map("resources_excluded")
  /// Element-level completeness, 0..1: (kept + changed) / source elements.
  completeness      Float?
  /// Per-type counts and scores; ids and counts only, no PHI.
  summary           Json?
  /// Human-readable fidelity report (Markdown).
  report            String?
  /// The exported bundle as serialized (exact bytes the hash covers). Null for a dry run.
  bundle            String?
  bundleSha256      String?        @map("bundle_sha256")
  bundleBytes       Int?           @map("bundle_bytes")
  /// Failure reason (types and counts only, no PHI).
  error             String?

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@map("transfer_jobs")
}

enum ReconcileCategory {
  PROBLEM
  PMH
  MEDICATION
  ALLERGY
}

enum ReconcileMatch {
  /// Same fact on both sides and nothing that differs.
  SAME
  /// Same fact on both sides, with differences or extra detail (see flags).
  CHANGED
  /// Only in the incoming record.
  NEW
  /// Only in the current chart.
  CURRENT_ONLY
}

enum ClaimKind {
  SUMMARY
  FLAG
}

enum DecisionAction {
  ACCEPT
  REJECT
  EDIT
}

/// Phase 4: one reconciliation of a patient's incoming (outside) records against the current chart.
/// The current chart is the Bundle primaries as of `cutoff`; incoming is the C-CDA copy. Never writes canonical rows.
model ReconciliationRun {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  requestedBy   String   @map("requested_by")
  createdAt     DateTime @default(now()) @map("created_at")
  cutoff        DateTime @db.Timestamptz(3)
  rulesVersion  String   @map("rules_version")
  /// Who wrote the summary: "anthropic", "replay" (recorded response) or "template" (no AI, rule-built).
  responder     String
  /// "ok" | "failed"
  aiStatus      String   @map("ai_status")
  /// Model requested and model that served it (a refusal fallback can differ). Null for the template.
  model         String?
  servedModel   String?  @map("served_model")
  promptVersion String?  @map("prompt_version")
  /// sha256 of the exact prompt input; a recording is replayed only for the same hash.
  inputSha256   String?  @map("input_sha256")
  /// Model output text exactly as returned, before validation.
  aiRaw         String?  @map("ai_raw")
  /// Failure reason (stop reason, error class, schema failure); no PHI.
  aiError       String?  @map("ai_error")
  /// Counts only: items by category and match, flags by code, claims valid and dropped.
  summary       Json?
  /// Phase 5 (SMART launch): the outside record's patient when it is not `patientId` (null: same patient).
  incomingPatientId     String? @map("incoming_patient_id") @db.Uuid
  /// Phase 5: the current chart is exactly this source record (the EHR read at launch), not the Bundle primaries.
  currentSourceRecordId String? @map("current_source_record_id") @db.Uuid

  patient         Patient                  @relation("RunPatient", fields: [patientId], references: [id])
  incomingPatient Patient?                 @relation("RunIncomingPatient", fields: [incomingPatientId], references: [id])
  currentSource   SourceRecord?            @relation(fields: [currentSourceRecordId], references: [id])
  items           ReconciliationItem[]
  claims    ReconciliationClaim[]
  decisions ReconciliationDecision[]

  @@index([patientId, createdAt])
  @@map("reconciliation_runs")
}

/// One line of the side-by-side view: a current row, an incoming row, or a matched pair, with deterministic flags.
model ReconciliationItem {
  id         String            @id @default(uuid()) @db.Uuid
  runId      String            @map("run_id") @db.Uuid
  ordinal    Int
  category   ReconcileCategory
  match      ReconcileMatch
  currentId  String?           @map("current_id") @db.Uuid
  incomingId String?           @map("incoming_id") @db.Uuid
  /// The rows as shown: the current one as of the cutoff, the incoming one as received (after mapping).
  current    Json?
  incoming   Json?
  /// Rule flags: [{code, severity, message, sourceIds}]. Every flag cites canonical ids.
  flags      Json

  run         ReconciliationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  currentRow  CanonicalResource?       @relation("ItemCurrent", fields: [currentId], references: [id])
  incomingRow CanonicalResource?       @relation("ItemIncoming", fields: [incomingId], references: [id])
  decisions   ReconciliationDecision[]

  @@unique([runId, ordinal])
  @@map("reconciliation_items")
}

/// One AI (or template) statement: a summary sentence or a flag. Kept even when invalid, with the reasons.
model ReconciliationClaim {
  id           String    @id @default(uuid()) @db.Uuid
  runId        String    @map("run_id") @db.Uuid
  ordinal      Int
  kind         ClaimKind
  /// Summary topic (active_problem, past_history, medication, allergy) or flag type.
  topic        String
  text         String
  /// Aliases exactly as cited, and the canonical ids they resolve to.
  citedAliases String[]  @map("cited_aliases")
  sourceIds    String[]  @map("source_ids")
  valid        Boolean
  /// Why it was dropped: no_source, unknown_id, hallucinated_condition, miscited_condition.
  problems     String[]

  run       ReconciliationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  decisions ReconciliationDecision[]

  @@unique([runId, ordinal])
  @@map("reconciliation_claims")
}

/// Provider decision on an item or a claim. Append-only (trigger); the latest decision per target wins.
/// EDIT stores a provider-authored copy of the resource; canonical rows are never written.
model ReconciliationDecision {
  id             BigInt         @id @default(autoincrement())
  runId          String         @map("run_id") @db.Uuid
  itemId         String?        @map("item_id") @db.Uuid
  claimId        String?        @map("claim_id") @db.Uuid
  action         DecisionAction
  actor          String
  decidedAt      DateTime       @default(now()) @map("decided_at")
  note           String?
  editedResource Json?          @map("edited_resource")

  run   ReconciliationRun    @relation(fields: [runId], references: [id])
  item  ReconciliationItem?  @relation(fields: [itemId], references: [id])
  claim ReconciliationClaim? @relation(fields: [claimId], references: [id])

  @@index([runId, decidedAt])
  @@map("reconciliation_decisions")
}

/// Phase 5: one SMART on FHIR launch (EHR or standalone). The browser cookie holds a random id; this row is keyed by
/// its sha256. Tokens and the PKCE verifier exist only inside `state_enc` (AES-256-GCM with SESSION_SECRET).
model SmartSession {
  id             String    @id
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  expiresAt      DateTime  @map("expires_at")
  /// "ehr" | "standalone"
  launchType     String    @map("launch_type")
  iss            String
  /// fhirclient's storage (authorization state, code verifier, token response), encrypted. Never logged.
  stateEnc       String?   @map("state_enc")
  authorizedAt   DateTime? @map("authorized_at")
  /// Granted scope as returned by the token endpoint.
  scope          String?
  fhirUser       String?   @map("fhir_user")
  fhirPatientId  String?   @map("fhir_patient_id")
  encounterId    String?   @map("encounter_id")
  /// Local patient index row and source record created from the launch read.
  patientId      String?   @map("patient_id") @db.Uuid
  sourceRecordId String?   @map("source_record_id") @db.Uuid
  /// Per-query counts and error classes from the launch read; no PHI.
  fetchSummary   Json?     @map("fetch_summary")

  patient      Patient?      @relation(fields: [patientId], references: [id])
  sourceRecord SourceRecord? @relation(fields: [sourceRecordId], references: [id])

  @@index([expiresAt])
  @@map("smart_sessions")
}

/// Phase 6 roles. VIEWER reads; PROVIDER also decides, writes back and transfers; ADMIN also exports the audit log.
enum Role {
  VIEWER
  PROVIDER
  ADMIN
}

/// A role granted to one SMART user (actor `smart:<fhirUser>`) with `pnpm roles`. Without a row, a Practitioner or
/// PractitionerRole fhirUser is PROVIDER and anyone else VIEWER. Every grant and revoke is audited.
model UserRole {
  actor     String   @id
  role      Role
  grantedBy String   @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at")

  @@map("user_roles")
}
