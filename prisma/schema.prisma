// MediSync data model. Synthetic data only.
// Raw sources are stored untouched; canonical resources are FHIR R4 JSON derived from them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SourceFormat {
  FHIR_BUNDLE
  FHIR_NDJSON
  CCDA
}

enum IssueSeverity {
  INFO
  WARNING
  ERROR
}

enum IssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

/// Which pipeline step raised an issue; a step replaces only its own OPEN issues when it re-runs.
enum IssueStage {
  INGEST
  MAPPING
  DEDUPE
  EXPORT
}

/// Lifecycle of a transfer job. Jobs run synchronously today; the states also fit a queue later.
enum TransferStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Terminology outcome for a canonical resource's primary code.
enum MappingStatus {
  MAPPED // known system, well-formed code, present in the local terminology table
  UNMAPPED // has a code, but the system or code is unknown or malformed; in the review queue
  NO_CODE // the type expects a primary code and has none (or only text)
  NOT_APPLICABLE // the type has no primary code (Patient)
}

enum AuditAction {
  READ
  CREATE
  UPDATE
  DELETE
  EXPORT
}

/// Patient index. Demographics are a convenience copy; the canonical Patient resource is the source of truth.
model Patient {
  id              String    @id @default(uuid()) @db.Uuid
  sourceSystem    String    @map("source_system")
  sourcePatientId String    @map("source_patient_id")
  displayName     String?   @map("display_name")
  birthDate       DateTime? @map("birth_date") @db.Date
  gender          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sourceRecords      SourceRecord[]
  canonicalResources CanonicalResource[]
  mappingIssues      MappingIssue[]
  transferJobs       TransferJob[]

  @@unique([sourceSystem, sourcePatientId])
  @@map("patients")
}

/// One received document (bundle, NDJSON file, C-CDA). raw_text is the exact original text, never modified.
model SourceRecord {
  id             String       @id @default(uuid()) @db.Uuid
  patientId      String?      @map("patient_id") @db.Uuid
  format         SourceFormat
  sourceSystem   String       @map("source_system")
  sourceRecordId String?      @map("source_record_id")
  filename       String?
  contentType    String       @map("content_type")
  rawText        String       @map("raw_text")
  sha256         String       @unique
  byteSize       Int          @map("byte_size")
  /// Derived at ingest (e.g. resource counts). Never a substitute for raw_text.
  summary        Json?
  receivedAt     DateTime     @default(now()) @map("received_at")
  /// Set once canonical rows and issues exist for this source. Raw is immutable; derived rows are not re-made.
  parsedAt       DateTime?    @map("parsed_at")
  parserVersion  String?      @map("parser_version")

  patient            Patient?            @relation(fields: [patientId], references: [id])
  canonicalResources CanonicalResource[]
  mappingIssues      MappingIssue[]

  @@index([patientId])
  @@map("source_records")
}

/// FHIR R4 resource in the canonical model, with provenance back to its source record.
model CanonicalResource {
  id             String   @id @default(uuid()) @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  sourceRecordId String   @map("source_record_id") @db.Uuid
  resourceType   String   @map("resource_type")
  fhirId         String   @map("fhir_id")
  fhirVersion    String   @default("4.0.1") @map("fhir_version")
  resource       Json
  /// Location in the raw source, e.g. "Bundle.entry[12]" or an XPath.
  sourcePath     String?  @map("source_path")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Phase 2. `resource` stays the canonical copy as received; `mapped` is that copy after terminology and unit
  // normalization plus meta.source, recomputed from `resource` whenever the mapping version changes.
  mapped         Json?
  mappingVersion String?        @map("mapping_version")
  mappingStatus  MappingStatus? @map("mapping_status")
  /// Primary clinical code after mapping (medicationReference resolved), for dedupe, coverage and reconcile.
  codeSystem     String?        @map("code_system")
  code           String?
  /// Provenance: the system that asserted the resource and the clinical date it asserts.
  sourceSystem   String?        @map("source_system")
  sourceDate     DateTime?      @map("source_date") @db.Timestamptz(3)
  /// Cross-format duplicates of one clinical fact share a key; all but one point at the primary row.
  dedupeKey      String?        @map("dedupe_key")
  duplicateOfId  String?        @map("duplicate_of_id") @db.Uuid

  patient       Patient             @relation(fields: [patientId], references: [id])
  sourceRecord  SourceRecord        @relation(fields: [sourceRecordId], references: [id])
  mappingIssues MappingIssue[]
  duplicateOf   CanonicalResource?  @relation("Duplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    CanonicalResource[] @relation("Duplicates")

  @@unique([sourceRecordId, resourceType, fhirId])
  @@index([patientId, resourceType])
  @@index([patientId, dedupeKey])
  @@index([mappingStatus])
  @@map("canonical_resources")
}

/// Review queue: validation failures, unmapped codes, lossy conversions. Nothing is silently dropped.
model MappingIssue {
  id                  String        @id @default(uuid()) @db.Uuid
  patientId           String?       @map("patient_id") @db.Uuid
  sourceRecordId      String        @map("source_record_id") @db.Uuid
  canonicalResourceId String?       @map("canonical_resource_id") @db.Uuid
  stage               IssueStage    @default(INGEST)
  severity            IssueSeverity
  code                String
  message             String
  path                String?
  details             Json?
  status              IssueStatus   @default(OPEN)
  resolvedBy          String?       @map("resolved_by")
  resolvedAt          DateTime?     @map("resolved_at")
  createdAt           DateTime      @default(now()) @map("created_at")

  patient           Patient?           @relation(fields: [patientId], references: [id])
  sourceRecord      SourceRecord       @relation(fields: [sourceRecordId], references: [id])
  canonicalResource CanonicalResource? @relation(fields: [canonicalResourceId], references: [id])

  @@index([status, code])
  @@index([stage, canonicalResourceId])
  @@index([patientId])
  @@map("mapping_issues")
}

/// Append-only (enforced by trigger). No FKs so entries outlive the rows they describe. details must not hold PHI.
model AuditLog {
  id         BigInt      @id @default(autoincrement())
  occurredAt DateTime    @default(now()) @map("occurred_at")
  actor      String
  action     AuditAction
  patientId  String?     @map("patient_id") @db.Uuid
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  source     String?
  details    Json?

  @@index([patientId, occurredAt])
  @@index([occurredAt])
  @@map("audit_log")
}

/// One transfer of a patient's canonical record to a target profile (Phase 3: US Core FHIR transaction Bundle).
/// A dry run computes everything (diff, score, report, bundle hash) but does not keep the bundle.
model TransferJob {
  id                String         @id @default(uuid()) @db.Uuid
  patientId         String         @map("patient_id") @db.Uuid
  dryRun            Boolean        @map("dry_run")
  status            TransferStatus @default(PENDING)
  /// e.g. "us-core@6.1.0"
  targetProfile     String         @map("target_profile")
  requestedBy       String         @map("requested_by")
  createdAt         DateTime       @default(now()) @map("created_at")
  startedAt         DateTime?      @map("started_at")
  finishedAt        DateTime?      @map("finished_at")
  /// The export timestamp written into the bundle and Provenance; same inputs + same exportedAt = same bytes.
  exportedAt        DateTime?      @map("exported_at") @db.Timestamptz(3)
  resourcesSelected Int?           @map("resources_selected")
  resourcesExported Int?           @map("resources_exported")
  resourcesExcluded Int?           @map("resources_excluded")
  /// Element-level completeness, 0..1: (kept + changed) / source elements.
  completeness      Float?
  /// Per-type counts and scores; ids and counts only, no PHI.
  summary           Json?
  /// Human-readable fidelity report (Markdown).
  report            String?
  /// The exported bundle as serialized (exact bytes the hash covers). Null for a dry run.
  bundle            String?
  bundleSha256      String?        @map("bundle_sha256")
  bundleBytes       Int?           @map("bundle_bytes")
  /// Failure reason (types and counts only, no PHI).
  error             String?

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@map("transfer_jobs")
}
