# Copy to .env (gitignored). Never put real PHI or production credentials here.

# Postgres (local, CI service container, or Supabase). With Supabase, use the pooled URL here.
DATABASE_URL="postgresql://medisync:medisync@localhost:5432/medisync"

# Anthropic API (Phase 4). Requires a BAA before any real PHI is ever sent.
# Optional. Without it, reconciliation uses a rule-built cited summary and needs no network access.
ANTHROPIC_API_KEY=""
# Optional model override for reconciliation summaries (default claude-sonnet-5-5).
ANTHROPIC_MODEL=""

# SMART on FHIR / Epic sandbox (Phase 5). Register at https://fhir.epic.com.
SMART_CLIENT_ID=""
SMART_ISS="https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4"
SMART_REDIRECT_URI="http://localhost:3000/smart/callback"
