# Copy to .env (gitignored). Never put real PHI or production credentials here.

# Postgres (local, CI service container, or Supabase). With Supabase, use the pooled URL here.
DATABASE_URL="postgresql://medisync:medisync@localhost:5432/medisync"

# Encryption at rest (Phase 6) for source_records.raw_text and stored transfer bundles. Comma-separated
# <id>:<base64 of 32 random bytes> (`echo "k1:$(openssl rand -base64 32)"`). New values use DATA_KEY_ID (default: the
# first key). To rotate: add a new key, point DATA_KEY_ID at it, run `pnpm crypt:rotate`, then drop the old key.
# Required in production; unset in development, raw text is stored unencrypted (synthetic data only).
DATA_KEYS=""
DATA_KEY_ID=""

# Demo mode (Phase 6) opens the seeded Synthea patients (/demo, /reconcile, /api/transfer) without a login.
# 1 = on, 0 = off. Unset: on in development and tests, off in a production build (`next start`).
DEMO_MODE=""

# Anthropic API (Phase 4). Requires a BAA before any real PHI is ever sent.
# Optional. Without it, reconciliation uses a rule-built cited summary and needs no network access.
ANTHROPIC_API_KEY=""
# Optional model override for reconciliation summaries (default claude-sonnet-5-5).
ANTHROPIC_MODEL=""

# SMART on FHIR (Phase 5). One app registration per EHR, so each server has its own client id (public client,
# PKCE S256, no client secret). Runbooks: docs/EPIC_SANDBOX.md, docs/ORACLE_SANDBOX.md.
# Named form (several EHRs): list the names, then SMART_<NAME>_ISS, SMART_<NAME>_CLIENT_ID, optional SMART_<NAME>_SCOPE.
# The first name is the default for standalone launch; an EHR launch is routed by its exact iss; any other iss is refused.
SMART_SERVERS=""
SMART_EPIC_ISS="https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4"
SMART_EPIC_CLIENT_ID=""
# Oracle Health (Cerner) code-console sandbox tenant; from memory, confirm against your app registration.
SMART_ORACLE_ISS="https://fhir-ehr-code.cerner.com/r4/ec2458f2-1e24-41c8-b71b-0e701af7583d"
SMART_ORACLE_CLIENT_ID=""
# Single-server form, used when SMART_SERVERS is empty (e.g. the local mock: `pnpm mock:smart`,
# iss http://127.0.0.1:4010/fhir, client id medisync-mock-client). SMART_ISS may be a comma list sharing one client id.
SMART_CLIENT_ID=""
SMART_ISS=""
# Optional: replaces the default read scopes (patient/<Type>.read for the types MediSync reads). Space-separated.
SMART_SCOPE=""
# Shared by every server; each registration must list it exactly.
SMART_REDIRECT_URI="http://localhost:3000/smart/callback"
# Encrypts SMART tokens at rest in smart_sessions. 32+ random bytes, base64: `openssl rand -base64 32`
SESSION_SECRET=""
